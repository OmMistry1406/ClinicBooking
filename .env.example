# IANA time zone of the clinic. REQUIRED - the app refuses to start/health-check if missing or invalid.
CLINIC_TZ=UTC
# Comma-separated closed dates (YYYY-MM-DD), optional
HOLIDAYS=2026-12-25,2027-01-01

# Cloudflare Turnstile site key (public). Test key that always passes: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Supabase (server-side only; never expose the service role key to the browser)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Postgres connection string, used by `npm run migrate`
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres
