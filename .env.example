# IANA time zone of the clinic. REQUIRED - the app refuses to start/health-check if missing or invalid.
CLINIC_TZ=UTC
# Comma-separated closed dates (YYYY-MM-DD), optional
HOLIDAYS=2026-12-25,2027-01-01

# Optional schedule (defaults shown); times are clinic-local HH:MM, weekdays 0=Sun..6=Sat
# OPEN_TIME=09:00
# CLOSE_TIME=17:00
# LUNCH_START=12:00
# LUNCH_END=13:00
# SLOT_MINUTES=30
# BOOKING_WINDOW_DAYS=30
# OPEN_WEEKDAYS=1,2,3,4,5

# Cloudflare Turnstile site key (public). Test key that always passes: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Supabase (server-side only; never expose the service role key to the browser)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used only by `npm run create-staff` (temp password optional; generated if empty, min 12 chars)
STAFF_EMAIL=
STAFF_TEMP_PASSWORD=

# Postgres connection string, used by `npm run migrate`
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres
